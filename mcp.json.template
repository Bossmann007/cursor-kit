{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "token-engine": {
      "command": "/ABS/PATH/TO/token-engine/.venv/bin/python",
      "args": ["-m", "token_engine.mcp.server"],
      "env": {
        "PYTHONPATH": "/ABS/PATH/TO/token-engine/src"
      }
    },
    "codebase-memory": {
      "command": "npx",
      "args": ["-y", "codebase-memory-mcp@latest"]
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    }
  }
}
