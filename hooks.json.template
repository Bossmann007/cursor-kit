{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 __CURSOR_HOOKS_DIR__/token-engine-session.py"
      }
    ],
    "postToolUse": [
      {
        "command": "python3 __CURSOR_HOOKS_DIR__/compress-tool-output.py",
        "matcher": "Shell|Read"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 __CURSOR_HOOKS_DIR__/tool-failure.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 __CURSOR_HOOKS_DIR__/track-edits.py"
      }
    ],
    "stop": [
      {
        "command": "python3 __CURSOR_HOOKS_DIR__/checkpoint-stop.py"
      }
    ]
  }
}
